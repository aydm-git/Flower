SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SHOP_TIMEZONE=Asia/Novosibirsk

# Optional e-mail notifications. Recipients are set in the admin panel (Settings tab).
# Yandex: smtp.yandex.ru, Mail.ru: smtp.mail.ru, Gmail: smtp.gmail.com — port 465, app password.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Set to 1 when the site is served over HTTPS.
SESSION_COOKIE_SECURE=0
# Number of trusted reverse proxies (nginx etc.) in front of the app; 0 = none.
TRUSTED_PROXIES=0

# Local development only.
FLASK_DEBUG=0
